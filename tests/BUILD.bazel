load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@rules_temporal//:defs.bzl",
    "temporal_build",
    "temporal_health_check",
    "temporal_namespace_config",
    "temporal_server",
    "temporal_test",
)

# ---------------------------------------------------------------------------
# Worker: hello_worker
#
# Registers HelloWorkflow, EchoWorkflow, MathWorkflow, CounterWorkflow.
# Used by all smoke tests.
#
# #4: the fixture worker takes temporalio from the same pinned hub as the
# built-in replay runner (@rules_temporal_pypi), so no test needs a host
# `pip install temporalio`. That is a choice for this repo's fixtures only:
# consumers' workers bring their own temporalio.
# ---------------------------------------------------------------------------

exports_files(
    ["workers/hello_worker.py"],
    visibility = ["//tests:__subpackages__"],
)

py_library(
    name           = "hello_workflows",
    srcs           = ["workers/hello_worker.py"],
    visibility     = ["//tests:__subpackages__"],
    deps           = ["@rules_temporal_pypi//temporalio"],
)

py_binary(
    name           = "hello_worker_bin",
    srcs           = ["workers/hello_worker.py"],
    main           = "workers/hello_worker.py",
    python_version = "3.12",
    visibility     = ["//tests:__subpackages__"],
    deps           = ["@rules_temporal_pypi//temporalio"],
)

temporal_build(
    name           = "hello_worker",
    worker_binary  = ":hello_worker_bin",
    workflow_module = "workers/hello_worker.py",
    task_queue     = "test-hello-queue",
    workflow_types = [
        "HelloWorkflow",
        "EchoWorkflow",
        "MathWorkflow",
        "CounterWorkflow",
    ],
    activity_types = [
        "greet_activity",
        "add_activity",
        "multiply_activity",
    ],
    visibility     = ["//tests:__subpackages__"],
)

# ---------------------------------------------------------------------------
# Smoke test: HelloWorkflow, EchoWorkflow, MathWorkflow
# ---------------------------------------------------------------------------

temporal_test(
    name   = "hello_test",
    worker = ":hello_worker",
    srcs   = ["hello_test.sh"],
    size   = "medium",
    tags   = ["temporal"],
)

# ---------------------------------------------------------------------------
# Namespace config test: custom search attributes
# ---------------------------------------------------------------------------

temporal_namespace_config(
    name   = "test_namespace_config",
    worker = ":hello_worker",
    search_attributes = {
        "TestCustomerId": "Keyword",
        "TestOrderTotal": "Double",
    },
)

temporal_test(
    name             = "namespace_config_test",
    worker           = ":hello_worker",
    namespace_config = ":test_namespace_config",
    srcs             = ["namespace_config_test.sh"],
    size             = "medium",
    tags             = ["temporal"],
)

# ---------------------------------------------------------------------------
# Replay test: export a live workflow's history and replay it with
# $TEMPORAL_REPLAY_RUNNER (the built-in, hermetic runner). No `history`, so
# the runner is attached explicitly. Committed-history replay, the runner's
# error messages and temporal_replay_runner: //tests/replay.
# ---------------------------------------------------------------------------

temporal_test(
    name   = "temporal_replay_test",
    worker = ":hello_worker",
    srcs   = ["temporal_replay_test.sh"],
    size   = "medium",
    tags   = ["temporal"],
    builtin_replay_runner = True,
)

# ---------------------------------------------------------------------------
# temporal_server + temporal_health_check tests
#
# temporal_server_test_svc is a long-running Temporal dev server (not a
# temporal_test).  temporal_server_test starts it as a subprocess and
# verifies it writes its env file and exits cleanly on SIGTERM.
#
# temporal_health_check_test verifies the health-check shell script exits
# 0/non-zero based solely on whether the env file is present.
# ---------------------------------------------------------------------------

temporal_server(
    name = "temporal_server_test_svc",
)

temporal_health_check(
    name   = "temporal_server_test_health",
    server = ":temporal_server_test_svc",
)

sh_test(
    name = "temporal_server_test",
    srcs = ["temporal_server_test.sh"],
    args = ["$(rootpath :temporal_server_test_svc)"],
    data = [":temporal_server_test_svc"],
    size = "large",
    tags = ["temporal"],
)

sh_test(
    name = "temporal_health_check_test",
    srcs = ["temporal_health_check_test.sh"],
    args = ["$(rootpath :temporal_server_test_health)"],
    data = [":temporal_server_test_health"],
    size = "small",
    tags = ["temporal"],
)

# ---------------------------------------------------------------------------
# Launcher unit test (#10): readiness timeouts. No server, no temporalio.
# ---------------------------------------------------------------------------

py_test(
    name = "launcher_unit_test",
    srcs = ["launcher_unit_test.py"],
    data = ["//private:launcher.py"],
    size = "small",
)

# ---------------------------------------------------------------------------
# #13: //:temporal is a runnable CLI target; a consumer's binary takes it in
# `data` and finds it at $(rlocationpath).
# ---------------------------------------------------------------------------

sh_test(
    name = "temporal_cli_test",
    srcs = ["temporal_cli_test.sh"],
    args = ["$(rlocationpath //:temporal)"],
    data = ["//:temporal"],
)
