"""temporal_replay_runner macro: a history replay runner built against the
consumer's own Python deps (#4).

The built-in runner (//private:replay_runner) replays with the temporalio
pinned in private/requirements_lock.txt and loads `temporal_build`'s
`workflow_module` by path, so the workflow module can import temporalio and
the standard library but nothing else. When a workflow module needs other
third-party packages, or replay must run on the same temporalio version as
the worker, build a runner with this macro and pass it as temporal_build's
`replay_runner`.
"""

load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_python//python:py_binary.bzl", "py_binary")

# The interpreter the built-in runner pins (py_binary python_version). Keep in
# step with python.toolchain / pip.parse in MODULE.bazel and
# tools/update_replay_requirements.sh.
REPLAY_PYTHON_VERSION = "3.12"

def temporal_replay_runner(
        name,
        workflow_module,
        workflow_types,
        deps,
        python_version = None,
        **kwargs):
    """A replay runner for Python workflows, built against your deps.

    Produces a py_binary that follows the custom replay-runner contract
    (`<runner> <history_file>`, exit 0 when the history replays, non-zero on
    non-determinism or a bad history), so it plugs into
    `temporal_build(replay_runner = ...)`, which takes precedence over the
    built-in runner and `workflow_module`.

    Unlike the built-in runner, the workflow module is imported by name from
    `deps`: its third-party imports resolve, and replay uses whatever
    temporalio `deps` bring (pin the same one as your worker). Uses the same
    runner source as the built-in runner, so the error messages match.

    Example:

        py_library(
            name = "workflows",
            srcs = ["workflows.py"],
            deps = ["@my_pypi//temporalio", "@my_pypi//pydantic"],
        )

        temporal_replay_runner(
            name            = "replay_runner",
            workflow_module = "myapp.workflows",   # import name, not a path
            workflow_types  = ["OrderWorkflow"],
            deps            = [":workflows"],
        )

        temporal_build(
            name           = "worker",
            worker_binary  = ":worker_bin",
            task_queue     = "orders",
            workflow_types = ["OrderWorkflow"],
            replay_runner  = ":replay_runner",
        )

    Args:
        name:            Target name (a py_binary).
        workflow_module: Import name of the module that defines the workflow
                         classes, e.g. "myapp.workflows".
        workflow_types:  Workflow class names to register with the Replayer
                         (normally temporal_build's workflow_types).
        deps:            py_library targets providing the workflow module,
                         its third-party imports and a temporalio.
        python_version:  Optional py_binary python_version (e.g. "3.12") when
                         your pip hub is built for a non-default interpreter.
        **kwargs:        Forwarded to the py_binary (visibility, tags, ...).
    """
    if not workflow_module or "/" in workflow_module or workflow_module.endswith(".py"):
        fail("temporal_replay_runner {}: workflow_module = {}: expected an import name like \"pkg.workflows\", not a file path.".format(
            name,
            repr(workflow_module),
        ))
    if not workflow_types:
        fail("temporal_replay_runner {}: workflow_types must list at least one workflow class.".format(name))
    for t in workflow_types:
        if not t or "," in t:
            fail("temporal_replay_runner {}: bad workflow_types entry {}.".format(name, repr(t)))

    main = name + "_replay_main.py"
    write_file(
        name = name + "_replay_main",
        out = main,
        content = [
            "# Generated by temporal_replay_runner(name = {}).".format(repr(name)),
            "import replay_runner",
            "",
            "replay_runner.main_by_name({}, {})".format(
                repr(workflow_module),
                repr(list(workflow_types)),
            ),
            "",
        ],
        visibility = ["//visibility:private"],
    )
    binary_kwargs = dict(kwargs)
    if python_version:
        binary_kwargs["python_version"] = python_version
    py_binary(
        name = name,
        srcs = [main],
        main = main,
        deps = list(deps) + [Label("//private:replay_runner_lib")],
        **binary_kwargs
    )
